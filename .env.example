# Backend Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=propvoice_ai

# CORS & Server
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Lead Qualification Scoring Weights (must sum to 100)
SCORE_WEIGHT_INTENT=25
SCORE_WEIGHT_BUDGET=25
SCORE_WEIGHT_COMPLETENESS=25
SCORE_WEIGHT_TIMELINE=15
SCORE_WEIGHT_ENGAGEMENT=10

# Frontend Configuration (create frontend/.env if needed)
VITE_API_BASE_URL=http://localhost:8000
